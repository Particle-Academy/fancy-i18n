{
  "fixtureVersion": 1,
  "about": "The shared fixture for Laravel's message format. fancy-i18n's vitest suite runs it against the JS port, and fancy-translations' Pest suite runs the same file against its validator and MessageSelector, so the two cannot drift without a red build. Every expected value was checked against Laravel's own Translator::makeReplacements and MessageSelector (laravel/framework 13.34.0). Where a case uses a locale stock Laravel does not recognise (es-MX, zh-Hans, ksw-Mymr), the kit normalises it; `laravelLocale` names the tag stock Laravel needs to give the same answer.",
  "replace": [
    { "name": "lowercase placeholder", "line": "Hello :name", "values": { "name": "taylor" }, "expected": "Hello taylor" },
    { "name": "ucfirst variant", "line": ":Name arrived", "values": { "name": "taylor" }, "expected": "Taylor arrived" },
    { "name": "upper variant", "line": ":NAME!", "values": { "name": "taylor" }, "expected": "TAYLOR!" },
    { "name": "strtr leaves the tail of a longer word: :counts with count", "line": ":counts left", "values": { "count": 5 }, "expected": "5s left" },
    { "name": "longest match wins: :counts with count and counts", "line": ":count and :counts", "values": { "count": 5, "counts": 9 }, "expected": "5 and 9" },
    { "name": "two placeholders", "line": "Page :page of :pages", "values": { "page": 2, "pages": 10 }, "expected": "Page 2 of 10" },
    { "name": "no placeholders", "line": "No placeholders here", "values": { "name": "x" }, "expected": "No placeholders here" },
    { "name": "unknown placeholder stays as written", "line": "Missing :other stays", "values": { "name": "x" }, "expected": "Missing :other stays" },
    { "name": "a colon followed by a space is text", "line": "Time: :time", "values": { "time": "5" }, "expected": "Time: 5" },
    { "name": "adjacent placeholders", "line": ":name:name", "values": { "name": "a" }, "expected": "aa" },
    { "name": "multibyte ucfirst", "line": "Bonjour :Name", "values": { "name": "élan" }, "expected": "Bonjour Élan" },
    { "name": "multibyte upper with full case mapping", "line": ":NAME", "values": { "name": "straße" }, "expected": "STRASSE" },
    { "name": "Cyrillic upper", "line": ":NAME", "values": { "name": "привет" }, "expected": "ПРИВЕТ" },
    { "name": "null fills with nothing", "line": "[:name]", "values": { "name": null }, "expected": "[]" },
    { "name": "true fills with 1", "line": "[:flag]", "values": { "flag": true }, "expected": "[1]" },
    { "name": "false fills with nothing", "line": "[:flag]", "values": { "flag": false }, "expected": "[]" },
    { "name": "float", "line": ":n kg", "values": { "n": 1.5 }, "expected": "1.5 kg" },
    { "name": "one-letter key: the upper variant overwrites the ucfirst one", "line": ":A :a", "values": { "a": "xy" }, "expected": "XY xy" },
    { "name": "capitalised key: the raw value overwrites the ucfirst one", "line": ":Name :NAME", "values": { "Name": "bob" }, "expected": "bob BOB" },
    { "name": "a later key's variant overwrites an earlier one", "line": ":Ab", "values": { "ab": "one", "Ab": "two" }, "expected": "two" },
    { "name": "a placeholder at the very end", "line": "Total: :total", "values": { "total": 42 }, "expected": "Total: 42" },
    { "name": "a bare colon at the end", "line": "Note:", "values": { "note": "x" }, "expected": "Note:" }
  ],
  "choice": [
    { "name": "en singular", "line": "apple|apples", "locale": "en", "number": 1, "expected": "apple" },
    { "name": "en plural", "line": "apple|apples", "locale": "en", "number": 2, "expected": "apples" },
    { "name": "en zero is plural", "line": "apple|apples", "locale": "en", "number": 0, "expected": "apples" },
    { "name": "en negative one uses abs", "line": "apple|apples", "locale": "en", "number": -1, "expected": "apple" },
    { "name": "choice fills :count", "line": ":count apple|:count apples", "locale": "en", "number": 3, "expected": "3 apples" },
    { "name": "an explicit count value wins over the number", "line": ":count apple|:count apples", "locale": "en", "number": 3, "values": { "count": "three" }, "expected": "three apples" },
    { "name": "choice fills :Count too", "line": ":Count|:Count", "locale": "en", "number": 7, "expected": "7" },
    { "name": "condition {0}", "line": "{0} No items|{1} One item|[2,5] A few items|[6,*] Many items", "locale": "en", "number": 0, "expected": "No items" },
    { "name": "condition {1}", "line": "{0} No items|{1} One item|[2,5] A few items|[6,*] Many items", "locale": "en", "number": 1, "expected": "One item" },
    { "name": "condition [2,5]", "line": "{0} No items|{1} One item|[2,5] A few items|[6,*] Many items", "locale": "en", "number": 3, "expected": "A few items" },
    { "name": "condition [6,*] at its bound", "line": "{0} No items|{1} One item|[2,5] A few items|[6,*] Many items", "locale": "en", "number": 6, "expected": "Many items" },
    { "name": "condition [6,*] far out", "line": "{0} No items|{1} One item|[2,5] A few items|[6,*] Many items", "locale": "en", "number": 100, "expected": "Many items" },
    { "name": "condition [*,0] takes a negative", "line": "[*,0] None|[1,*] Some", "locale": "en", "number": -1, "expected": "None" },
    { "name": "condition segments are trimmed", "line": "{0}  none |[1,*] some", "locale": "en", "number": 0, "expected": "none" },
    { "name": "a float inside a range", "line": "[0,1.5] small|[2,*] big", "locale": "en", "number": 1.2, "expected": "small" },
    { "name": "no condition matches, so the plural index decides", "line": "{0} none|apple|apples", "locale": "en", "number": 2, "expected": "apple" },
    { "name": "index segments are NOT trimmed", "line": "one apple | many apples", "locale": "en", "number": 2, "expected": " many apples" },
    { "name": "one segment is returned for any number", "line": "only", "locale": "ru", "number": 5, "expected": "only" },
    { "name": "a missing index falls back to segment 0", "line": "яблоко|яблока", "locale": "ru", "number": 5, "expected": "яблоко" },

    { "name": "es 1", "line": "manzana|manzanas", "locale": "es", "number": 1, "expected": "manzana" },
    { "name": "es 0", "line": "manzana|manzanas", "locale": "es", "number": 0, "expected": "manzanas" },
    { "name": "es-MX normalises to es_MX", "line": "manzana|manzanas", "locale": "es-MX", "laravelLocale": "es_MX", "number": 2, "expected": "manzanas" },
    { "name": "de 1", "line": "Apfel|Äpfel", "locale": "de", "number": 1, "expected": "Apfel" },
    { "name": "de 2", "line": "Apfel|Äpfel", "locale": "de", "number": 2, "expected": "Äpfel" },
    { "name": "ru 1", "line": "яблоко|яблока|яблок", "locale": "ru", "number": 1, "expected": "яблоко" },
    { "name": "ru 2", "line": "яблоко|яблока|яблок", "locale": "ru", "number": 2, "expected": "яблока" },
    { "name": "ru 5", "line": "яблоко|яблока|яблок", "locale": "ru", "number": 5, "expected": "яблок" },
    { "name": "ru 11", "line": "яблоко|яблока|яблок", "locale": "ru", "number": 11, "expected": "яблок" },
    { "name": "ru 21", "line": "яблоко|яблока|яблок", "locale": "ru", "number": 21, "expected": "яблоко" },
    { "name": "ru 22", "line": "яблоко|яблока|яблок", "locale": "ru", "number": 22, "expected": "яблока" },
    { "name": "ru 1.5 truncates to 1", "line": "яблоко|яблока|яблок", "locale": "ru", "number": 1.5, "expected": "яблоко" },
    { "name": "zh-Hans normalises to zh: one form", "line": ":count 个文件|:count 个文件", "locale": "zh-Hans", "laravelLocale": "zh", "number": 5, "expected": "5 个文件" },
    { "name": "pl 1", "line": "plik|pliki|plików", "locale": "pl", "number": 1, "expected": "plik" },
    { "name": "pl 2", "line": "plik|pliki|plików", "locale": "pl", "number": 2, "expected": "pliki" },
    { "name": "pl 5", "line": "plik|pliki|plików", "locale": "pl", "number": 5, "expected": "plików" },
    { "name": "pl 12", "line": "plik|pliki|plików", "locale": "pl", "number": 12, "expected": "plików" },
    { "name": "pl 22", "line": "plik|pliki|plików", "locale": "pl", "number": 22, "expected": "pliki" },
    { "name": "hi 0 takes the first form", "line": "फ़ाइल|फ़ाइलें", "locale": "hi", "number": 0, "expected": "फ़ाइल" },
    { "name": "hi 2", "line": "फ़ाइल|फ़ाइलें", "locale": "hi", "number": 2, "expected": "फ़ाइलें" },
    { "name": "ar 0", "line": "a0|a1|a2|a3|a4|a5", "locale": "ar", "number": 0, "expected": "a0" },
    { "name": "ar 2", "line": "a0|a1|a2|a3|a4|a5", "locale": "ar", "number": 2, "expected": "a2" },
    { "name": "ar 11", "line": "a0|a1|a2|a3|a4|a5", "locale": "ar", "number": 11, "expected": "a4" },
    { "name": "ar 102", "line": "a0|a1|a2|a3|a4|a5", "locale": "ar", "number": 102, "expected": "a5" }
  ],
